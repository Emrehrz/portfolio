---
import Card from '../Card.astro'
import { LINKS } from '../../lib/constants'
---

<Card
  colSpan="md:col-span-1 lg:col-start-2"
  rowSpan="md:row-span-2 lg:row-span-3 lg:row-start-[8]"
  title="Youtube"
  href={LINKS.youtube}
>
  <div class="flex h-full w-full flex-col">
    <div>
      <img
        width="50"
        height="50"
        src="/me_tattoo.png"
        class="pointer-events-none absolute bottom-[-80px] right-[-110px] z-[-1] max-h-[300px] w-auto select-none opacity-50 md:relative md:bottom-auto md:right-auto md:z-auto md:opacity-100"
        alt="memoji of andres with a tattoo on his arm"
      />
    </div>
    <div>
      <p class="mt-2 text-sm text-muted-foreground">If you want to see my contents, you can follow me on Youtube.</p>
    </div>
  </div>
</Card>
